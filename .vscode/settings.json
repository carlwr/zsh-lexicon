{
  "[typescript]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    },
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true
  },
  "[rust]": {
    "editor.formatOnSave": true
  },
  // rust-analyzer looks for a Cargo.toml at most one directory down.
  "rust-analyzer.linkedProjects": ["crates/zshref/Cargo.toml"]
}
